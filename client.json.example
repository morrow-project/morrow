{
  "server": "127.0.0.1:4222",
  "max_payload": 1048576,
  "tls": {
    "enabled": false,
    "server_name": "localhost",
    "ca_cert_file": "./ca-cert.pem"
  },
  "auth": {
    "enabled": false,
    "client_id": "client1",
    "private_key_seed_hex": "64-hex-character-ed25519-seed"
  },
  "connect": {
    "durable_id": "client1",
    "verbose": false,
    "ack_timeout_ms": 30000,
    "max_in_flight": 1024
  }
}
